# Copy this file to .env and fill in real values. .env is gitignored.

# SQLAlchemy connection string. Format:
#   postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://nestpath:changeme@localhost:5432/nestpath

# Secret used to sign JWTs (app/security.py). Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-random-secret
