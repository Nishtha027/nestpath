# Copy this file to .env and fill in real values. .env is gitignored.

# SQLAlchemy connection string. Format:
#   postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
# Use 127.0.0.1, not localhost -- on some machines (seen on Windows)
# resolving "localhost" adds tens of seconds per new connection.
DATABASE_URL=postgresql+psycopg://nestpath:changeme@127.0.0.1:5432/nestpath

# Secret used to sign JWTs (app/security.py). Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-random-secret

# Browser origins allowed to call the API (CORS), comma-separated. Production:
# set to the frontend's exact URL, e.g. https://nestpath.vercel.app -- nothing
# else is then allowed. Leave unset for local development, where any
# http://localhost:<port> is allowed.
# CORS_ORIGINS=https://your-app.vercel.app

# Only used by scripts/seed_demo_data.py (not the web service); pass them on
# the command line when seeding a deployed database rather than saving them here.
#   DEMO_PROVIDER_PASSWORD  required for any non-local database
#   DEMO_PROVIDER_EMAIL     default demo-provider@example.com
#   DEMO_SLOT_DAYS          how many days of appointment slots to create (default 7)
